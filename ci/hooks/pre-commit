#!/usr/bin/env bash
# Pre-commit hook: mod-parse + secret + credential checks before a commit lands.
# Activated (with pre-push) via: git config core.hooksPath ci/hooks
set -euo pipefail

# Fail closed: `cd ""` succeeds, so an empty result has to be rejected
# explicitly rather than relying on `cd ... || exit`.
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=""
if [ -z "$top" ]; then
  echo "pre-commit: not a git work tree — nothing was checked." >&2
  exit 1
fi
cd "$top"

echo "pre-commit: running checks ..."
if ! ./ci/checks.sh; then
  echo
  echo "pre-commit: checks failed — commit aborted."
  exit 1
fi
